{
  "rootDir": ".",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/utils/env.ts"],
  "globalSetup": "<rootDir>/utils/global-setup.js"
}
