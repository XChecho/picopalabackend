generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

model Player {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique @db.VarChar(24)
  email           String    @unique @db.VarChar(254)
  // Optional so social login can be added later without a breaking change.
  passwordHash    String?
  avatarUrl       String?
  language        Language  @default(ES)
  elo             Int       @default(1000)
  rank            Rank      @default(PLATA)
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions       Session[]
  devices        Device[]
  authTokens     AuthToken[]
  participations MatchParticipant[]
  roomsHosted    Room[]
  stats          PlayerStats[]

  @@index([elo])
  @@index([deletedAt])
  @@map("players")
}

// One-time tokens for email verification and password reset.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  playerId  String        @db.Uuid
  type      AuthTokenType
  // SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String        @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @db.Uuid
  // SHA-256 of the refresh token; the raw token is never stored.
  tokenHash String    @unique @db.Char(64)
  // Shared by every token of one rotation chain; reuse of a revoked token revokes the family.
  familyId  String    @db.Uuid
  platform  Platform
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  platform   Platform
  pushToken  String   @unique
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("devices")
}

// ─────────────────────────────────────────────
// Game
// ─────────────────────────────────────────────

model Match {
  id             String      @id @default(uuid()) @db.Uuid
  mode           GameMode
  status         MatchStatus @default(WAITING)
  endReason      EndReason?
  source         MatchSource @default(ONLINE)
  // Client-generated id for offline matches; makes /stats/sync idempotent.
  clientMatchId  String?     @unique @db.Uuid
  isRanked       Boolean     @default(false)
  maxTurns       Int         @default(12) @db.SmallInt
  aiDifficulty   Difficulty?
  // Seat (1 or 2) that played first, and whose turn it is now.
  startingSeat   Int?        @db.SmallInt
  currentSeat    Int?        @db.SmallInt
  // Server-side deadline of the current phase: secret selection while WAITING,
  // the turn clock while PLAYING. Resolved by MatchSchedulerService.
  turnDeadlineAt DateTime?
  roomId         String?     @unique @db.Uuid
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  room         Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants MatchParticipant[]
  moves        Move[]

  @@index([status, mode])
  @@index([status, turnDeadlineAt])
  @@index([finishedAt])
  @@map("matches")
}

model MatchParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  matchId        String       @db.Uuid
  seat           Int          @db.SmallInt
  // Null when the seat is the AI.
  playerId       String?      @db.Uuid
  isAi           Boolean      @default(false)
  // Never select this for the opponent; see MatchService projections.
  secretNumber   String?      @db.Char(4)
  result         MatchResult?
  attemptsUsed   Int          @default(0) @db.SmallInt
  eloBefore      Int?
  eloAfter       Int?
  rankBefore     Rank?
  rankAfter      Rank?
  // Consecutive turns the server had to play for this seat (timeout).
  missedTurns    Int          @default(0) @db.SmallInt
  // Set while the player has no live socket; cleared when they rejoin.
  disconnectedAt DateTime?
  createdAt      DateTime     @default(now())

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  moves  Move[]

  @@unique([matchId, seat])
  @@unique([matchId, playerId])
  @@index([playerId, createdAt])
  @@index([disconnectedAt])
  @@map("match_participants")
}

model Move {
  id            String   @id @default(uuid()) @db.Uuid
  matchId       String   @db.Uuid
  participantId String   @db.Uuid
  turnNumber    Int      @db.SmallInt
  guess         String   @db.Char(4)
  // Pico (fija): right digit, right position. Pala: right digit, wrong position.
  picos         Int      @db.SmallInt
  palas         Int      @db.SmallInt
  isWin         Boolean  @default(false)
  createdAt     DateTime @default(now())

  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // A player can't repeat a guess, and has one move per turn.
  @@unique([participantId, guess])
  @@unique([participantId, turnNumber])
  @@index([matchId, createdAt])
  @@map("moves")
}

// Private rooms only. Global matchmaking queue lives in Redis.
model Room {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(8)
  hostId    String     @db.Uuid
  status    RoomStatus @default(WAITING)
  maxTurns  Int        @default(12) @db.SmallInt
  /// Set when the room is a rematch offer for that finished match (at most one per match).
  rematchOfMatchId String? @unique @db.Uuid
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  host  Player @relation(fields: [hostId], references: [id], onDelete: Cascade)
  match Match?

  @@index([hostId])
  @@index([status, expiresAt])
  @@map("rooms")
}

// ─────────────────────────────────────────────
// Stats
// ─────────────────────────────────────────────

model PlayerStats {
  playerId         String   @db.Uuid
  mode             GameMode
  games            Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentStreak    Int      @default(0)
  bestStreak       Int      @default(0)
  // Fewest attempts needed to win (null until the first win).
  bestAttempts     Int?     @db.SmallInt
  totalAttempts    Int      @default(0)
  totalPicos       Int      @default(0)
  totalPalas       Int      @default(0)
  totalDurationSec Int      @default(0)
  updatedAt        DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, mode])
  @@map("player_stats")
}

// ─────────────────────────────────────────────
// Public web
// ─────────────────────────────────────────────

model WaitlistSubscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(254)
  locale         Language  @default(ES)
  source         String?   @db.VarChar(64)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@map("waitlist_subscribers")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(254)
  subject   String   @db.VarChar(150)
  message   String   @db.VarChar(5000)
  // SHA-256 of the sender IP, for abuse control without storing the address.
  ipHash    String?  @db.Char(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum Language {
  ES
  EN
  PT
}

enum Rank {
  BRONCE
  PLATA
  ORO
  PLATINO
  DIAMANTE
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum GameMode {
  VERSUS_AI
  PRIVATE
  GLOBAL
}

enum MatchStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

enum EndReason {
  GUESSED
  MAX_TURNS
  ABANDONED
  TIMEOUT
  RESIGNED
}

enum MatchSource {
  ONLINE
  OFFLINE_SYNC
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoomStatus {
  WAITING
  IN_GAME
  CLOSED
  EXPIRED
}
